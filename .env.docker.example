# Шаблон настроек контейнерного окружения (ЛР №4).
# make container-env копирует его в .env.docker и сам генерирует случайные
# пароль БД и секрет JWT. Файл .env.docker в Git не добавляется.
# Настоящих паролей в этом шаблоне нет и быть не должно.

# База данных (контейнер db)
POSTGRES_DB=conference
POSTGRES_USER=conference
POSTGRES_PASSWORD=GENERATE_RANDOM

# Приложение
JWT_SECRET_KEY=GENERATE_RANDOM
APP_VERSION=0.5.0
# Порт на компьютере: http://127.0.0.1:8000 (если занят — например, 8001)
APP_PORT=8000

# Том с данными PostgreSQL (меняется при восстановлении в новый том)
PGDATA_VOLUME=conference_pgdata
