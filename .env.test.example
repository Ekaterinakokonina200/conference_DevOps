# Настройки ТОЛЬКО для автоматических тестов (make test, make verify).
# make setup копирует этот файл в .env.test; .env.test в Git не добавляется.
# Имя базы обязано оканчиваться на _test: тесты удаляют и заново создают
# в ней все таблицы, поэтому рабочая база conference не используется.
TEST_DATABASE_URL=postgresql://postgres:LOCAL_PASSWORD@localhost:5432/conference_test
