# Настройки предэксплуатационного окружения staging (ЛР №6) — шаблон.
#
# Настоящий файл хранится ТОЛЬКО на сервере conference-app:
#   /srv/conference-staging/staging.env   (владелец deploy, права 600)
# Его создаёт администратор сервера (см. docs/cd.md), пароли генерируются
# командой openssl rand -hex 24. В Git и в образ настоящий файл не попадает.
# Каждая настройка — на отдельной строке, без кавычек и пробелов вокруг "=".

# Образ приложения в registry (тег выбирает deploy.sh: sha-xxxxxxx или X.Y.Z)
APP_IMAGE=ghcr.io/ekaterinakokonina200/conference-app

# Где открыт порт приложения: host-only адрес сервера и порт
APP_BIND=192.168.56.10
APP_PORT=8080

# База данных staging (контейнер db, том conference_staging_pgdata)
POSTGRES_DB=conference
POSTGRES_USER=conference
POSTGRES_PASSWORD=CHANGE_ME

# Приложение
JWT_SECRET_KEY=CHANGE_ME
ACCESS_TOKEN_EXPIRE_MINUTES=30
